<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="update_gate.xml" />
        <exclude domain="sharedpref" path="offline_device_access.xml" />
        <exclude domain="sharedpref" path="device_access.xml" />
        <exclude domain="file" path="update-gate/" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="external" path="Download/update-gate/" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="update_gate.xml" />
        <exclude domain="sharedpref" path="offline_device_access.xml" />
        <exclude domain="sharedpref" path="device_access.xml" />
        <exclude domain="file" path="update-gate/" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="external" path="Download/update-gate/" />
    </device-transfer>
</data-extraction-rules>
